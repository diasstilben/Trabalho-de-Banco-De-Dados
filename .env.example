# ============================================================================
# Arquivo de exemplo (.env.example) — configurações de conexão com o MySQL.
#
# Para usar, copie este arquivo com o nome ".env" e ajuste os valores:
#     cp .env.example .env
#
# O arquivo ".env" NÃO deve ser versionado no GitHub (ele está no .gitignore),
# pois pode conter senha. Cada integrante do grupo usa as suas credenciais.
# ============================================================================

# Endereço do servidor do banco de dados
MYSQL_HOST=localhost

# Porta padrão do MySQL/MariaDB
MYSQL_PORT=3306

# Usuário do banco (padrão usado em sala: root)
MYSQL_USER=root

# Senha do usuário (vazia = conexão sem senha)
MYSQL_PASSWORD=

# Nome do banco de dados criado no hospital.sql
MYSQL_DATABASE=HOSPITAL